{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "공휴일 (data/holidays/holidays.json)",
  "description": "YYYY-MM-DD 문자열 배열. 오름차순 여부는 스키마로 검사하지 못한다.",
  "type": "array",
  "uniqueItems": true,
  "items": {
    "$ref": "#/definitions/date"
  },
  "definitions": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "YYYY-MM-DD"
    }
  }
}
