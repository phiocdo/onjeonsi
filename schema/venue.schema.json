{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "시설 (data/venues/{id}.json)",
  "description": "data/venues/{id}.json 파일 하나에 시설 한 곳을 적는다. 상태: 확정 (src/types/index.ts의 Venue와 같은 필드). 사람이 손으로 쓰는 파일이라 정해지지 않은 키는 오타로 보고 거부한다. 파일 이름은 id와 같아야 한다 (예: venue-mmca.json의 id는 venue-mmca). 스키마로 잡지 못하는 것: 파일 이름과 id가 같은지, 시설 id가 파일 사이에서 겹치는지, hours의 open이 close보다 이른지, lastEntry가 각 요일의 open~close 사이인지, closed.weekday인 요일에 hours가 없는지, 없는 날짜(예: 2026-02-30)인지.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "aliases",
    "gu",
    "type",
    "lat",
    "lng",
    "representative",
    "source",
    "verified"
  ],
  "properties": {
    "id": {
      "$ref": "#/definitions/venueId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "전시 placeName과 이어 줄 이름. 연결은 공백·괄호·층을 지운 뒤 부분 일치로 한다"
    },
    "gu": {
      "type": "string",
      "enum": [
        "종로구",
        "중구"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "미술관",
        "박물관"
      ]
    },
    "lat": {
      "type": "number",
      "minimum": 37.4,
      "maximum": 37.7,
      "description": "위도. 서울 범위로 제한해 위도·경도를 바꿔 적은 실수를 잡는다"
    },
    "lng": {
      "type": "number",
      "minimum": 126.7,
      "maximum": 127.3,
      "description": "경도"
    },
    "representative": {
      "type": "boolean",
      "description": "true이면 hours와 lastEntry가 필수"
    },
    "hours": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "mon": {
          "$ref": "#/definitions/hoursEntry"
        },
        "tue": {
          "$ref": "#/definitions/hoursEntry"
        },
        "wed": {
          "$ref": "#/definitions/hoursEntry"
        },
        "thu": {
          "$ref": "#/definitions/hoursEntry"
        },
        "fri": {
          "$ref": "#/definitions/hoursEntry"
        },
        "sat": {
          "$ref": "#/definitions/hoursEntry"
        },
        "sun": {
          "$ref": "#/definitions/hoursEntry"
        }
      },
      "description": "문 여는 요일만 적는다. 빠진 요일은 판정이 '확인 필요'. hours를 적으면 lastEntry도 적어야 한다"
    },
    "closed": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "dependencies": {
        "ifHoliday": [
          "weekday"
        ]
      },
      "properties": {
        "weekday": {
          "$ref": "#/definitions/weekday",
          "description": "정기 휴관 요일 하나. 배열은 허용하지 않는다 (엔진이 읽지 못한다)"
        },
        "ifHoliday": {
          "type": "string",
          "enum": [
            "nextDay"
          ],
          "description": "nextDay: 휴관 요일이 공휴일이면 개관하고 다음 날 휴관. weekday가 있어야 하고, 그 요일의 hours도 있어야 한다"
        },
        "dates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(\\d{4}-)?(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "description": "지정 휴관일. 매년 반복은 MM-DD, 그해만은 YYYY-MM-DD"
        }
      }
    },
    "lastEntry": {
      "$ref": "#/definitions/time",
      "description": "입장 마감 HH:MM. 모든 요일에 같은 값을 쓰므로 각 요일의 open~close 사이여야 한다 (스키마로는 검사하지 못한다). hours를 적으면 함께 적어야 한다"
    },
    "visitMinutes": {
      "type": "integer",
      "minimum": 10,
      "maximum": 480,
      "description": "관람에 걸리는 분. 모르면 키를 뺀다 (엔진 기본값 60분)"
    },
    "docent": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "days",
          "times"
        ],
        "properties": {
          "days": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/weekday"
            }
          },
          "times": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/time"
            }
          }
        }
      },
      "description": "도슨트 요일과 회차 시각 (표시용, 판정에 쓰지 않는다)"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "description": "입장 방식 (표시용)"
    },
    "reservation": {
      "type": "string",
      "minLength": 1,
      "description": "예약 여부 (표시용)"
    },
    "source": {
      "type": "string",
      "pattern": "^https?://\\S+$",
      "description": "운영 정보를 확인한 페이지의 http(s) URL. 공식 홈페이지 우선"
    },
    "verified": {
      "$ref": "#/definitions/date"
    }
  },
  "dependencies": {
    "hours": [
      "lastEntry"
    ],
    "lastEntry": [
      "hours"
    ]
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "representative": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "representative"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "hours",
          "lastEntry"
        ],
        "properties": {
          "hours": {
            "type": "object"
          },
          "lastEntry": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "closed": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "string",
                "const": "mon"
              },
              "ifHoliday": {
                "type": "string",
                "const": "nextDay"
              }
            },
            "required": [
              "weekday",
              "ifHoliday"
            ]
          }
        },
        "required": [
          "closed"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "hours"
        ],
        "properties": {
          "hours": {
            "type": "object",
            "required": [
              "mon"
            ],
            "properties": {
              "mon": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "closed": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "string",
                "const": "tue"
              },
              "ifHoliday": {
                "type": "string",
                "const": "nextDay"
              }
            },
            "required": [
              "weekday",
              "ifHoliday"
            ]
          }
        },
        "required": [
          "closed"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "hours"
        ],
        "properties": {
          "hours": {
            "type": "object",
            "required": [
              "tue"
            ],
            "properties": {
              "tue": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "closed": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "string",
                "const": "wed"
              },
              "ifHoliday": {
                "type": "string",
                "const": "nextDay"
              }
            },
            "required": [
              "weekday",
              "ifHoliday"
            ]
          }
        },
        "required": [
          "closed"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "hours"
        ],
        "properties": {
          "hours": {
            "type": "object",
            "required": [
              "wed"
            ],
            "properties": {
              "wed": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "closed": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "string",
                "const": "thu"
              },
              "ifHoliday": {
                "type": "string",
                "const": "nextDay"
              }
            },
            "required": [
              "weekday",
              "ifHoliday"
            ]
          }
        },
        "required": [
          "closed"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "hours"
        ],
        "properties": {
          "hours": {
            "type": "object",
            "required": [
              "thu"
            ],
            "properties": {
              "thu": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "closed": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "string",
                "const": "fri"
              },
              "ifHoliday": {
                "type": "string",
                "const": "nextDay"
              }
            },
            "required": [
              "weekday",
              "ifHoliday"
            ]
          }
        },
        "required": [
          "closed"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "hours"
        ],
        "properties": {
          "hours": {
            "type": "object",
            "required": [
              "fri"
            ],
            "properties": {
              "fri": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "closed": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "string",
                "const": "sat"
              },
              "ifHoliday": {
                "type": "string",
                "const": "nextDay"
              }
            },
            "required": [
              "weekday",
              "ifHoliday"
            ]
          }
        },
        "required": [
          "closed"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "hours"
        ],
        "properties": {
          "hours": {
            "type": "object",
            "required": [
              "sat"
            ],
            "properties": {
              "sat": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "closed": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "string",
                "const": "sun"
              },
              "ifHoliday": {
                "type": "string",
                "const": "nextDay"
              }
            },
            "required": [
              "weekday",
              "ifHoliday"
            ]
          }
        },
        "required": [
          "closed"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "hours"
        ],
        "properties": {
          "hours": {
            "type": "object",
            "required": [
              "sun"
            ],
            "properties": {
              "sun": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "venueId": {
      "type": "string",
      "pattern": "^venue-[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "시설 id. venue- 뒤에 영문 소문자·숫자를 하이픈으로 잇는다. 한 번 정하면 바꾸지 않는다"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "YYYY-MM-DD"
    },
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "description": "HH:MM, 24시간제 두 자리 (00:00~23:59). 9:00, 24:00은 허용하지 않는다"
    },
    "weekday": {
      "type": "string",
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "hoursEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open",
        "close"
      ],
      "properties": {
        "open": {
          "$ref": "#/definitions/time"
        },
        "close": {
          "$ref": "#/definitions/time"
        }
      }
    }
  }
}
