# 서울 열린데이터광장 문화행사 API 인증키
# 발급: https://data.seoul.go.kr
SEOUL_DATA_API_KEY=

# 공공데이터포털 특일(공휴일) API 인증키
# 발급: https://www.data.go.kr
HOLIDAY_API_KEY=

# 한국문화정보원 한눈에보는문화정보 API 인증키 (manual.json 보충 후보 찾기, 선택)
# 발급: https://www.data.go.kr — 스크립트는 환경 변수에서만 읽는다(.env를 읽지 않음)
KCISA_API_KEY=

# 카카오맵 JavaScript 키
VITE_KAKAO_MAP_KEY=

# 카카오 REST API 키 (시설 카카오맵 장소 ID 찾기, 선택) — 같은 앱의 REST API 키
# scripts/find-kakao-place-ids.ts는 환경 변수에서만 읽는다(.env를 읽지 않음)
KAKAO_REST_API_KEY=

# Supabase 공유 별점·관람 시간 (선택, 없으면 예시 기록/기록 부족으로 동작)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
