{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "전시 목록 (data/exhibitions/auto.json)",
  "description": "수집 스크립트가 만드는 파일이라 모르는 키는 허용한다. 선택 항목은 null도 허용한다 (수집 데이터에 null이 있다). 실제 auto.json으로 먼저 검사해 보고 어긋나는 곳은 스키마나 수집 스크립트를 고친다. 파일 전체가 배열이라고 가정했다. id가 겹치는지는 스키마로 검사하지 못한다.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "venueId",
      "title",
      "start",
      "end"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "description": "전시 ID. 고정 ID여야 한다 (가이드 4장)"
      },
      "venueId": {
        "type": "string",
        "description": "연결된 시설 id. 연결 전에는 빈 문자열"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "start": {
        "$ref": "#/definitions/date"
      },
      "end": {
        "$ref": "#/definitions/date"
      },
      "field": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "placeName": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "hoursText": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "API 운영 시간 원문. 판정에 쓰지 않는다"
      },
      "lat": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "lng": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "link": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "fetchedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "definitions": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "YYYY-MM-DD"
    }
  }
}
