{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "인기 시설 목록 (data/popular-venues.json)",
  "description": "data/popular-venues.json, 상태: 제안. venueIds는 앞에 있을수록 인기가 높다. 스키마로 잡지 못하는 것: venueIds가 data/venues에 실제로 있는 id인지.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "basis",
    "verified",
    "venueIds"
  ],
  "properties": {
    "basis": {
      "type": "string",
      "minLength": 1,
      "description": "팀이 정한 인기 기준 한 줄"
    },
    "verified": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "기준을 확인한 날 YYYY-MM-DD"
    },
    "venueIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^venue-[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "시설 id (data/venues/{id}.json), 중복 없이 인기 순"
    }
  }
}
