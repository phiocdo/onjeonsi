{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "개인 기록 내보내기 파일",
  "description": "개인 기록 내보내기 파일 (사용자가 아카이브 화면에서 내려받는 JSON, 저장소에는 두지 않는다). 타입은 src/types/records.ts의 ArchiveExport, 만드는 함수는 src/lib/archive.ts의 buildExport. 화면은 localStorage의 onjeonsi:archive에 같은 모양(exportedAt 제외)으로 저장한다. 스키마로 잡지 못하는 것: 기록 id가 겹치는지, exhibitionId가 실제 전시인지, 없는 날짜(2026-02-30 등).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "exportedAt",
    "records",
    "interests"
  ],
  "definitions": {
    "isoDateTime": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d+)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "nullableText": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "nullableDate": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    }
  },
  "properties": {
    "version": {
      "type": "integer",
      "const": 2,
      "description": "파일 형식 버전. 1은 필드 이름이 exhibitId·time이고 전시 정보 사본이 없던 형식"
    },
    "exportedAt": {
      "$ref": "#/definitions/isoDateTime",
      "description": "내보낸 시각, ISO 8601 날짜시간 (예: 2026-11-21T09:30:00.000Z)"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "exhibitionId",
          "exhibition",
          "date",
          "rating",
          "visitMinutes",
          "note",
          "shared",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "기록 id"
          },
          "exhibitionId": {
            "type": "string",
            "minLength": 1,
            "description": "전시 id (data/exhibitions/auto.json의 id)"
          },
          "exhibition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "venueName", "venueId", "field", "imageUrl", "start", "end"],
            "description": "전시 정보 사본. 기록할 때 만들고, 카탈로그에 전시가 있는 동안은 읽을 때마다 최신으로 고친다. 전시가 끝나 auto.json에서 빠져도 기록을 보여 주려고 둔다",
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "venueName": { "$ref": "#/definitions/nullableText" },
              "venueId": { "$ref": "#/definitions/nullableText", "description": "시설 id (venue-*)" },
              "field": { "$ref": "#/definitions/nullableText", "description": "서울시 대분류 (전시/미술 등)" },
              "imageUrl": { "$ref": "#/definitions/nullableText" },
              "start": { "$ref": "#/definitions/nullableDate", "description": "전시 시작일 YYYY-MM-DD" },
              "end": { "$ref": "#/definitions/nullableDate", "description": "전시 종료일 YYYY-MM-DD. 지났으면 화면에 '종료된 전시'로 표시" }
            }
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
            "description": "관람한 날 YYYY-MM-DD"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "별점 1~5 정수"
          },
          "visitMinutes": {
            "type": "integer",
            "minimum": 10,
            "maximum": 480,
            "description": "실제 관람 시간(분) 10~480 정수 (범위는 stats.ts와 같다. 소수 입력은 저장할 때 반올림)"
          },
          "note": {
            "type": "string",
            "description": "개인 메모. 빈 문자열 허용. 공유 평가로 옮기지 않는다"
          },
          "shared": {
            "type": "boolean",
            "description": "별점·관람 시간·태그 익명 공유 동의"
          },
          "createdAt": {
            "$ref": "#/definitions/isoDateTime",
            "description": "기록을 만든 시각"
          },
          "tags": {
            "type": "array",
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 15
            },
            "description": "사용자 태그 (선택). src/lib/userTags.ts의 normalizeTags로 정리한 값(한글·영문 소문자·숫자·공백·'·'). 태그가 없으면 필드를 두지 않는다. shared가 true면 익명으로 서버에 공유한다. #71의 주제 태그(src/lib/tags.ts)와 다르다"
          }
        }
      }
    },
    "interests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "관심 분야. 값은 전시의 field(서울시 대분류)와 같은 종류"
    }
  }
}
